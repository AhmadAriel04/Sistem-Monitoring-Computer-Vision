APP_NAME="BSI Survey Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# DATABASE: WAJIB SAMA dengan Sistem Survey (Kiosk) - ini shared database.
# Sistem ini yang memegang skema (migration) - jalankan `php artisan
# migrate` HANYA di sini, jangan di app Kiosk.
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bsi_survey
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=bsi_survey_monitor_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=bsi_monitor

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# KONEKSI KE SISTEM SURVEY (KIOSK)
# Alamat tempat Sistem Survey (Kiosk) berjalan. Dipakai untuk tombol
# "Buka Sistem Survey" dan generate QR Code di halaman /qrcode
# ----------------------------------------------------------------------
KIOSK_URL=http://localhost:8000

# ==========================================================
# COMPUTER VISION API
# ==========================================================

CV_API_TOKEN=e150062280bc724fec0aae9135679b14764e4f9216464720454c47caf82a532a

CV_CONFIDENCE_THRESHOLD=0.60

CV_CONFIRMATION_TTL_MINUTES=3

CV_COUNTER_CODE=CS-01

VITE_APP_NAME="${APP_NAME}"
